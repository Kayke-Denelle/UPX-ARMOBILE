  m_Script: {fileID: 11500000, guid: fc6f06cd85c7ca7488caf15564cf6ded, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MuseuAR.HotspotPoint
  title: Canto dobrado
  kind: 2
  description: "Cada dobra rompe as fibras do papel, e o vinco nunca some por completo. Para desdobrar uma folha antiga, conservadores-restauradores primeiro a umidificam devagar, deixando as fibras flex\xEDveis, e s\xF3 depois a planificam sob peso."
  narration: {fileID: 0}
  labelOffset: {x: -0.025676727, y: 0.07298756, z: -0.062828064}
  relatedItem: {fileID: 0}
